# Copy to .env and edit
PORT=3000
NODE_ENV=development
# REQUIRED in production: long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me
# Where the SQLite DB and uploaded evidence are stored
# DATA_DIR=./data
TIMEZONE=Asia/Kolkata

# Optional: automatic SMS to emergency contacts on SOS (Twilio)
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# Google sign-in: create an OAuth "Web application" client at console.cloud.google.com
# and add http://localhost:3000 under Authorized JavaScript origins
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
